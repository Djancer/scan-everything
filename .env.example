# Actual local AI. "local" = simple rules; "mock" = synthetic test metadata.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT=600
OCR_PROVIDER=tesseract
TESSERACT_CMD=
TESSERACT_LANG=eng+deu
MAX_FILE_MB=20
MAX_LLM_CHARS=50000
DATA_DIR=./data
DATABASE_PATH=./data/documents.db
LOG_LEVEL=INFO

# Optional Telegram example only. Empty allowlist permits everyone: SET BEFORE RUNNING.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Optional remote API, never needed for local Qwen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
